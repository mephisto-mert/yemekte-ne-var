# Supabase Configuration (Multi-Tenant Backend & Auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Stripe Commercial Billing
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_your_monthly_price_id
VITE_STRIPE_PRO_ANNUAL_PRICE_ID=price_your_annual_price_id

# Server / Edge Function Secrets (Never expose in frontend)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Recipe Image Pipeline Provider Secrets (Server / Backend / CLI)
